Upstream: https://github.com/userchba/LibDDLA
Version: 0.0.7 (0a65e570d3d3bc70e4d53a7e992b2de60abc884c)
Purpose: Keep optional BLAS controls optional on Mach-O and label the
         process-level resource-profile fallback when RUSAGE_THREAD is absent.
License: LGPL-3.0, unchanged from upstream.
Upstream status: Not submitted. Temporary focused portability fix; remove
                 once a compatible upstream release includes these changes.
Why local: Preserve the selected release API while the platform changes are
           validated independently of later upstream algorithm development.

--- a/src/host_threads.h
+++ b/src/host_threads.h
@@ -16,13 +16,31 @@
 #include <sched.h>
 #endif
 
-// Optional BLAS thread controls (weak: null unless the linked BLAS exports them), used by ScopedBlasThreads below.
+#if defined(__APPLE__)
+#include <dlfcn.h>
+namespace ddla {
+namespace detail {
+// GCC's Darwin linker can retain undefined weak imports. Resolve optional
+// controls from the loaded BLAS instead, without requiring a second provider.
+inline auto openblas_set_num_threads = reinterpret_cast<void (*)(int)>(
+    dlsym(RTLD_DEFAULT, "openblas_set_num_threads"));
+inline auto openblas_get_num_threads = reinterpret_cast<int (*)(void)>(
+    dlsym(RTLD_DEFAULT, "openblas_get_num_threads"));
+inline auto mkl_set_num_threads = reinterpret_cast<void (*)(int)>(
+    dlsym(RTLD_DEFAULT, "mkl_set_num_threads"));
+inline auto mkl_get_max_threads = reinterpret_cast<int (*)(void)>(
+    dlsym(RTLD_DEFAULT, "mkl_get_max_threads"));
+}
+}
+#else
+// ELF weak symbols are null unless the linked BLAS exports them.
 extern "C" {
 void openblas_set_num_threads(int) __attribute__((weak));
 int  openblas_get_num_threads(void) __attribute__((weak));
 void mkl_set_num_threads(int) __attribute__((weak));
 int  mkl_get_max_threads(void) __attribute__((weak));
 }
+#endif
 
 namespace ddla {
 namespace detail {
