Source: https://github.com/abacusmodeling/LibRI/archive/a0661cbb4b4f89ceeb23e040d49accb00943093f.tar.gz
Portable allocator cleanup, including macOS; preserves the LibRPA local changes.
License: same as upstream. Upstream submission: not recorded.

--- /dev/null
+++ b/include/RI/global/Memory.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstdlib>
+
+#if defined(__GLIBC__)
+#include <malloc.h>
+#elif defined(__APPLE__) && defined(__MACH__)
+#include <malloc/malloc.h>
+#endif
+
+namespace RI
+{
+namespace Global_Func
+{
+// Ask the allocator to return unused memory without changing live allocations.
+// Allocators without a supported release API need no explicit action.
+inline void release_free_memory()
+{
+#if defined(__GLIBC__)
+    malloc_trim(0);
+#elif defined(__APPLE__) && defined(__MACH__)
+    malloc_zone_pressure_relief(malloc_default_zone(), 0);
+#endif
+}
+} // namespace Global_Func
+} // namespace RI
