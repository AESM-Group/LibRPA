# Driver parameters
task = qsgw
input_dir = ../dataset
constants_choice = aims

# G0W0 kernel
tfgrid_type = minimax
n_params_anacon = -1
n_params_anacon_resample = -1
anacon_nfreq = -1
parallel_routing = libri
vq_threshold = 0
sqrt_coulomb_threshold = 0
use_scalapack_gw_wc = true
use_shrink_abfs = false
use_shrink_chi = false
replace_w_head = false
use_symmetry_exx = false
use_symmetry_gw = false
use_symmetry_rpa = false
use_kpara_scf_eigvec = false

# QSGW fixed-basis iteration
qsgw_mixer = linear
qsgw_mixing_beta = 0.2
qsgw_min_iter = 2
qsgw_max_iter = 2
qsgw_convergence_tolerance_ev = 1e-4
qsgw_write_iteration_matrices = false

# Retain five occupied and ten empty states on grid and path.
qsgw_unoccupied_keep = 10
qsgw_cut_mode = 1
qsgw_cut_shift_ha = 0

# This retained fixture has no native H/S/r export.
qsgw_export_hamiltonian_for_pyatb = false

# Preserve the fixed-Hartree reference trajectory.
qsgw_update_hartree = false
