task = g0w0
input_preset = abacus
input_dir = ../dataset
# This dataset is reader-v1: name every sidecar explicitly so no fallback to
# the legacy stru_out k-point block is attempted.
fn_stru = stru_out.txt
fn_bz_sampling = bz_sampling_out
fn_basis_wfc = basis_wfc_out
fn_basis_aux = basis_aux_out
fn_basis_aux_shrink = basis_aux_shrink_out
fn_eigocc_scf = band_out.txt
fn_vxc_scf = vxc_out.dat
prefix_coul_full = v1_coulomb_full_iq_
prefix_coul_cut = v1_coulomb_cut_iq_
prefix_lri_coeff = v1_Cs_data_
prefix_lri_coeff_shrink = v1_Cs_shrinked_data_
prefix_shrink_sinvS = v1_shrink_sinvS_
prefix_eigvecs_scf = KS_eigenvector
nfreq = 6
n_params_anacon = 6
option_dielect_func = 3
option_velocity = native
g0w0_fn_hr = hrs1_nao.csr
g0w0_fn_hr_spin1 = hrs2_nao.csr
g0w0_fn_sr = sr_nao.csr
g0w0_fn_rr = rr.csr
g0w0_hr_unit = Ry
g0w0_rr_unit = Bohr
replace_w_head = t
parallel_routing = libri
vq_threshold = 0
sqrt_coulomb_threshold = 0
use_shrink_abfs = t
use_shrink_chi = t
version_coul_reader = 1
version_lri_reader = 1
use_kpara_scf_eigvec = t
# The whole point of this case: collinear nspin=2 with a real reduced grid.
# stru_out carries the 12 spatial operations plus the unitary-only identity-spin
# table that ABACUS writes for nspin=2. Without that table LibRPA completes the
# group to a grey group and rejects the antiunitary spin swap.
use_symmetry_exx = t
use_symmetry_gw = t
