task = qsgw
input_preset = abacus-legacy
input_dir = ../dataset
output_dir = .
output_level = info
version_lri_reader = 1
version_coul_reader = 1
prefix_lri_coeff = v1_Cs_data_
prefix_lri_coeff_hartree = v1_Cs_hartree_data_
prefix_coul_full = v1_coulomb_full_iq_
prefix_coul_cut = v1_coulomb_cut_iq_
prefix_coul_hartree = v1_coulomb_hartree_iq_
prefix_vxc_scf = vxc
fn_vxc_scf = vxc_out
qsgw_vxc_basis = state
parallel_routing = libri
use_shrink_abfs = false
use_shrink_chi = false
use_kpara_scf_eigvec = false
use_symmetry_exx = false
use_symmetry_gw = false
use_symmetry_rpa = false
use_pyatb = false
use_fullcoul_exx = false
use_fullcoul_eps = true
use_fullcoul_wc = false
replace_w_head = false
option_dielect_func = 0
nfreq = 6
tfgrids_type = minimax
n_params_anacon = -1
n_params_anacon_resample = -1
anacon_nfreq = -1
use_scalapack_gw_wc = true
vq_threshold = 0
cs_threshold = 0
sqrt_coulomb_threshold = 0
qsgw_mixer = none
qsgw_cut_mode = 0
qsgw_min_iter = 2
qsgw_max_iter = 2
qsgw_convergence_tolerance_ev = 1e-12
qsgw_write_iteration_matrices = true
qsgw_output_qp = true
qsgw_checkpoint_file = qsgw_checkpoint.bin
qsgw_restart_file = none
