<regressionsuite>

  <group name="RPA correlation energy" prefix="RPA">
    <testcase name="Water molecule in box (aims input, non-LibRI)" directory="rpa_aims_mole_H2O">
      <run ntasks_disable="none"
           nthreads_disable="none"
           ntasks_enable="none"
           nthreads_enable="none"
      />
      <validate name="Correlation energy"
                regex="Total EcRPA: \s+([-+]?\d*\.\d+)"
                comparison="cmp_float.abs_diff(1e-4)"
      />
    </testcase>

    <testcase name="Water molecule in box (aims input)" directory="rpa_aims_mole_H2O_libri">
      <build require_libri="true"
      />
      <run ntasks_disable="none"
           nthreads_disable="none"
           ntasks_enable="none"
           nthreads_enable="none"
      />
      <validate name="Correlation energy"
                regex="Total EcRPA: \s+([-+]?\d*\.\d+)"
                comparison="cmp_float.abs_diff(1e-4)"
      />
    </testcase>
    
    <testcase name="BN (abacus input)" directory="rpa_abacus_BN_libri">
      <build require_libri="true"
      />
      <run ntasks_disable="none"
           nthreads_disable="none"
           ntasks_enable="none"
           nthreads_enable="none"
      />
      <validate name="Correlation energy"
                regex="Total EcRPA: \s+([-+]?\d*\.\d+)"
                comparison="cmp_float.abs_diff(1e-4)"
      />
    </testcase>

    <testcase name="BN headwing symmetry kpara shrink reader v1 (abacus input)" directory="rpa_abacus_BN_headwing_sym_shrink_v1_libri">
      <labels refhash="a23a66d28f419302e87acaaf863f961278384fd7"
      />
      <build require_libri="true"
      />
      <run ntasks_disable="1"
           nthreads_disable="none"
           ntasks_enable="none"
           nthreads_enable="none"
      />
      <validate name="Head of dielectric function"
                regex="Freq.?ency node .* Head of dielectric function"
                headers="1"
                rows="6"
                comparison="cmp_table.abs_diff(1e-4)"
      />
      <validate name="Analytic head tensor off-diagonal diagnostic"
                regex="Head tensor diagnostics.*max_abs_offdiag=\s*([-+0-9.Ee]+)"
                comparison="cmp_float.abs_diff(1e-8)"
      />
      <validate name="Analytic wing mu pure-imaginary diagnostic"
                regex="Wing_mu diagnostics.*real_over_abs=\s*([-+0-9.Ee]+)"
                comparison="cmp_float.abs_diff(1e-8)"
      />
      <validate name="Analytic wing lambda pure-imaginary diagnostic"
                regex="Wing_lambda diagnostics.*real_over_abs=\s*([-+0-9.Ee]+)"
                comparison="cmp_float.abs_diff(1e-8)"
      />
      <validate name="Correlation energy"
                regex="Total EcRPA: \s+([-+]?\d*\.\d+)"
                comparison="cmp_float.abs_diff(1e-4)"
      />
    </testcase>


    <testcase name="H2 Delta-ST reader v1 RPA (abacus input)" directory="rpa_abacus_H2_delta_st_v1">
      <build require_libri="true"
      />
