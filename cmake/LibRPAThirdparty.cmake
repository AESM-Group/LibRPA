include_guard(GLOBAL)
set(_LIBRPA_THIRDPARTY_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(LIBRPA_SOURCE_DIR "${_LIBRPA_THIRDPARTY_MODULE_DIR}/.." ABSOLUTE)
# PATH cache entries normalize untyped relative -D values against CMake's
# invocation directory, before any existence checks or dependency resolution.
foreach(_path_variable LIBRI_INCLUDE_DIR LIBCOMM_INCLUDE_DIR CEREAL_INCLUDE_DIR
    GREENX_SOURCE_DIR EXTERNAL_GREENX_DIR ELPA_SOURCE_DIR EXTERNAL_ELPA_DIR ELPA_ROOT
    LIBDDLA_SOURCE_DIR LIBDDLA_PATH)
  set(${_path_variable} "${${_path_variable}}" CACHE PATH "Explicit third-party dependency path")
endforeach()
set(LIBRPA_THIRDPARTY_ARCHIVE_DIR "${LIBRPA_THIRDPARTY_ARCHIVE_DIR}" CACHE PATH "Archive directory; empty uses the environment or thirdparty/downloads")
option(LIBRPA_THIRDPARTY_DOWNLOAD "Download missing third-party archives" ON)

# Preserve environment selections across automatic reconfiguration. Keep the
# derived archive default uncached so it stays local to this checkout.
function(librpa_thirdparty_path variable out)
  set(_path "${${variable}}")
  set(_from_environment FALSE)
  if("${_path}" STREQUAL "" AND NOT "$ENV{${variable}}" STREQUAL "")
    set(_path "$ENV{${variable}}")
    set(_from_environment TRUE)
  endif()
  if(NOT "${_path}" STREQUAL "")
    if(NOT IS_ABSOLUTE "${_path}")
      message(FATAL_ERROR "${variable}='${_path}' is relative. Supply an absolute path. Untyped -D values resolve against the CMake invocation directory; environment values must be absolute.")
    endif()
  endif()
  if(_from_environment)
    set(${variable} "${_path}" CACHE PATH "Explicit third-party dependency path" FORCE)
    message(STATUS "${variable}: using and caching path from environment: ${_path}")
  endif()
  set(${out} "${_path}" PARENT_SCOPE)
endfunction()

function(librpa_thirdparty_archive_dir out)
  librpa_thirdparty_path(LIBRPA_THIRDPARTY_ARCHIVE_DIR _dir)
  if(NOT _dir)
    get_filename_component(_dir "${LIBRPA_SOURCE_DIR}/thirdparty/downloads" ABSOLUTE)
  endif()
  get_property(_reported GLOBAL PROPERTY LIBRPA_THIRDPARTY_ARCHIVE_REPORTED)
  if(NOT _reported)
    message(STATUS "Third-party archive directory: ${_dir}")
    set_property(GLOBAL PROPERTY LIBRPA_THIRDPARTY_ARCHIVE_REPORTED TRUE)
  endif()
  set(${out} "${_dir}" PARENT_SCOPE)
endfunction()

function(librpa_thirdparty_tree_sha256 out root)
  file(GLOB_RECURSE _files RELATIVE "${root}" LIST_DIRECTORIES false "${root}/*")
  list(SORT _files)
  set(_lines "")
  foreach(_file IN LISTS _files)
    # GLOB_RECURSE can list directory symlinks even with
    # LIST_DIRECTORIES false. Hashing directories is not portable.
    if(IS_DIRECTORY "${root}/${_file}")
      continue()
    endif()
    file(SHA256 "${root}/${_file}" _sha)
    string(APPEND _lines "${_sha}  ${_file}\n")
  endforeach()
  string(SHA256 _sha "${_lines}")
  set(${out} "${_sha}" PARENT_SCOPE)
endfunction()

function(librpa_thirdparty_declare name)
  cmake_parse_arguments(DEP "" "VERSION;URL;ARCHIVE;ARCHIVE_SHA256;HASH_SUBDIR;PRISTINE_SHA256;TREE_SHA256;LICENSE" "PATCHES" ${ARGN})
  foreach(_field VERSION URL ARCHIVE ARCHIVE_SHA256 TREE_SHA256 LICENSE)
    if(NOT DEP_${_field})
      message(FATAL_ERROR "${name}: missing manifest field ${_field}")
    endif()
  endforeach()
  if(NOT DEP_PRISTINE_SHA256)
    set(DEP_PRISTINE_SHA256 "${DEP_TREE_SHA256}")
  endif()
  foreach(_field VERSION URL ARCHIVE ARCHIVE_SHA256 HASH_SUBDIR PATCHES PRISTINE_SHA256 TREE_SHA256 LICENSE)
    set_property(GLOBAL PROPERTY LIBRPA_THIRDPARTY_${name}_${_field} "${DEP_${_field}}")
  endforeach()
  set_property(GLOBAL APPEND PROPERTY LIBRPA_THIRDPARTY_NAMES "${name}")
endfunction()

# Load a declaration into the caller's scope.
macro(_librpa_thirdparty_fields name)
  get_property(_known GLOBAL PROPERTY LIBRPA_THIRDPARTY_NAMES)
  if(NOT "${name}" IN_LIST _known)
    message(FATAL_ERROR "Unknown third-party component: ${name}; expected ${_known}")
  endif()
  foreach(_field VERSION URL ARCHIVE ARCHIVE_SHA256 HASH_SUBDIR PATCHES PRISTINE_SHA256 TREE_SHA256 LICENSE)
    get_property(_${_field} GLOBAL PROPERTY LIBRPA_THIRDPARTY_${name}_${_field})
  endforeach()
  string(SUBSTRING "${_TREE_SHA256}" 0 12 _short)
  set(_final "${LIBRPA_SOURCE_DIR}/thirdparty/src/${name}-${_short}")
endmacro()

# Tree hashes identify reference sources; local edits are allowed.
function(_librpa_thirdparty_check_tree name tree out)
  _librpa_thirdparty_fields("${name}")
  librpa_thirdparty_tree_sha256(_actual "${tree}/${_HASH_SUBDIR}")
  if(_actual STREQUAL _TREE_SHA256)
    set(${out} managed PARENT_SCOPE)
  else()
    message(WARNING "${name}: managed source differs from the pinned tree: ${tree}\nExpected SHA256: ${_TREE_SHA256}\nActual SHA256:   ${_actual}\nUsing this source without overwriting local changes (unpinned). Compatibility will be determined when compiling.")
    set(${out} unpinned PARENT_SCOPE)
  endif()
endfunction()

function(_librpa_thirdparty_patch name tree temporary)
  _librpa_thirdparty_fields("${name}")
  if(NOT _PATCHES)
    return()
  endif()
  get_filename_component(_ceiling "${temporary}" REALPATH)
  find_program(_LIBRPA_GIT git)
  find_program(_LIBRPA_PATCH patch)
  foreach(_patch IN LISTS _PATCHES)
    set(_patch "${LIBRPA_SOURCE_DIR}/thirdparty/patches/${_patch}")
    if(_LIBRPA_GIT)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${_ceiling}"
        "${_LIBRPA_GIT}" apply -p1 --whitespace=nowarn "${_patch}"
        WORKING_DIRECTORY "${tree}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    elseif(_LIBRPA_PATCH)
      execute_process(COMMAND "${_LIBRPA_PATCH}" -p1 -N -t -F 0 -i "${_patch}"
        WORKING_DIRECTORY "${tree}" RESULT_VARIABLE _result ERROR_VARIABLE _error OUTPUT_VARIABLE _output)
    else()
      set(_result 1)
      set(_error "Install git or patch to apply third-party patches")
    endif()
    if(NOT _result EQUAL 0)
      file(REMOVE_RECURSE "${temporary}")
      message(FATAL_ERROR "${name}: patch failed (${_patch}):\n${_error}\n${_output}")
    endif()
  endforeach()
endfunction()

# Publish a prepared tree. A competing configure may have published it first.
function(_librpa_thirdparty_publish name tree temporary)
  _librpa_thirdparty_fields("${name}")
  if(NOT EXISTS "${_final}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${tree}" "${_final}"
      RESULT_VARIABLE _result ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0 AND NOT EXISTS "${_final}")
      file(REMOVE_RECURSE "${temporary}")
      message(FATAL_ERROR "${name}: cannot publish managed tree: ${_error}")
    endif()
  endif()
  file(REMOVE_RECURSE "${temporary}")
endfunction()

function(_librpa_thirdparty_missing name detail)
  _librpa_thirdparty_fields("${name}")
  librpa_thirdparty_archive_dir(_archive_dir)
  message(FATAL_ERROR "Missing third-party component ${name}: ${detail}\nOn a connected machine, run from the same LibRPA source version:\n  cmake -DLIBRPA_THIRDPARTY_ARCHIVE_DIR=<archive-dir> -P cmake/LibRPADownloadThirdparty.cmake\nCopy the archives to ${_archive_dir}/ on this machine.\nThen configure with -DLIBRPA_THIRDPARTY_DOWNLOAD=OFF and, for a custom archive location, -DLIBRPA_THIRDPARTY_ARCHIVE_DIR=${_archive_dir}.\nAlternatively, obtain archive ${_ARCHIVE}\nfrom ${_URL}\nand place it in ${_archive_dir}/.")
endfunction()

# Ensure that an archive is available for extraction or transfer to another host.
function(librpa_thirdparty_download_archive name out)
  _librpa_thirdparty_fields("${name}")
  librpa_thirdparty_archive_dir(_archive_dir)
  set(_archive "${_archive_dir}/${_ARCHIVE}")
  set(_archive_help "Archive: ${_archive}\nIf this archive comes from a shared directory, delete it and configure again.")
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _random)
  if(NOT EXISTS "${_archive}")
    if(NOT LIBRPA_THIRDPARTY_DOWNLOAD)
      _librpa_thirdparty_missing("${name}" "downloads disabled")
    endif()
    # Probe through a subprocess so failure produces our actionable diagnostic
    # rather than an uncatchable file(WRITE) error (CMake 3.18).
    set(_download "${_archive}.tmp-${_random}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E make_directory "${_archive_dir}"
      RESULT_VARIABLE _mkdir ERROR_VARIABLE _write_error)
    if(_mkdir EQUAL 0)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E touch "${_download}"
        RESULT_VARIABLE _writable ERROR_VARIABLE _write_error)
    endif()
    if(NOT _mkdir EQUAL 0 OR NOT _writable EQUAL 0)
      message(FATAL_ERROR "Cannot write to third-party archive directory: ${_archive_dir}\nUse a writable LIBRPA_THIRDPARTY_ARCHIVE_DIR, or prefetch on a connected machine and place the archives in this directory.\n${_write_error}")
    endif()
    message(STATUS "Downloading ${name}: ${_URL}")
    file(DOWNLOAD "${_URL}" "${_download}" STATUS _status TLS_VERIFY ON INACTIVITY_TIMEOUT 60)
    list(GET _status 0 _code)
    if(NOT _code EQUAL 0)
      file(REMOVE "${_download}")
      _librpa_thirdparty_missing("${name}" "${_URL}: ${_status}")
    endif()
    file(SHA256 "${_download}" _actual)
    if(NOT _actual STREQUAL _ARCHIVE_SHA256)
      file(REMOVE "${_download}")
      _librpa_thirdparty_missing("${name}" "archive SHA256 mismatch; expected ${_ARCHIVE_SHA256}, got ${_actual}")
    endif()
    file(RENAME "${_download}" "${_archive}")
  endif()
  file(SHA256 "${_archive}" _actual)
  if(NOT _actual STREQUAL _ARCHIVE_SHA256)
    message(FATAL_ERROR "${name}: archive SHA256 mismatch\nExpected SHA256: ${_ARCHIVE_SHA256}\nActual SHA256:   ${_actual}\n${_archive_help}")
  endif()
  set(${out} "${_archive}" PARENT_SCOPE)
endfunction()

# An optional third argument receives the managed/unpinned source status.
function(librpa_thirdparty_prepare name out)
  _librpa_thirdparty_fields("${name}")
  if(NOT EXISTS "${_final}")
    librpa_thirdparty_download_archive("${name}" _archive)
    set(_archive_help "Archive: ${_archive}\nIf this archive comes from a shared directory, delete it and configure again.")
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _random)
    file(MAKE_DIRECTORY "${LIBRPA_SOURCE_DIR}/thirdparty/src")
    set(_temporary "${LIBRPA_SOURCE_DIR}/thirdparty/src/.tmp-${name}-${_random}")
    file(MAKE_DIRECTORY "${_temporary}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xzf "${_archive}"
      WORKING_DIRECTORY "${_temporary}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
    file(GLOB _tops "${_temporary}/*")
    list(LENGTH _tops _count)
    if(NOT _result EQUAL 0 OR NOT _count EQUAL 1)
      file(REMOVE_RECURSE "${_temporary}")
      message(FATAL_ERROR "${name}: archive extraction failed or did not produce one top-level directory: ${_error}\n${_archive_help}")
    endif()
    list(GET _tops 0 _tree)
    if(NOT IS_DIRECTORY "${_tree}")
      file(REMOVE_RECURSE "${_temporary}")
      message(FATAL_ERROR "${name}: archive top-level entry is not a directory\n${_archive_help}")
    endif()
    _librpa_thirdparty_patch("${name}" "${_tree}" "${_temporary}")
    _librpa_thirdparty_publish("${name}" "${_tree}" "${_temporary}")
  endif()
  _librpa_thirdparty_check_tree("${name}" "${_final}" _status)
  message(STATUS "${name}: ${_status}, source=${_final}")
  if(ARGC GREATER 2)
    set(${ARGV2} "${_status}" PARENT_SCOPE)
  endif()
  set(${out} "${_final}" PARENT_SCOPE)
endfunction()

function(librpa_thirdparty_use_path name user_path out status)
  _librpa_thirdparty_fields("${name}")
  librpa_thirdparty_tree_sha256(_hash "${user_path}")
  set(_resolved "${user_path}")
  if(_hash STREQUAL _TREE_SHA256)
    set(_status pinned)
  elseif(_hash STREQUAL _PRISTINE_SHA256)
    if(NOT EXISTS "${_final}")
      string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _random)
      set(_temporary "${LIBRPA_SOURCE_DIR}/thirdparty/src/.tmp-${name}-${_random}")
      set(_tree "${_temporary}/${name}")
      execute_process(COMMAND "${CMAKE_COMMAND}" -E make_directory "${_tree}/${_HASH_SUBDIR}"
        RESULT_VARIABLE _mkdir ERROR_VARIABLE _error)
      if(NOT _mkdir EQUAL 0)
        file(REMOVE_RECURSE "${_temporary}")
        message(FATAL_ERROR "${name}: cannot create an overlay in ${LIBRPA_SOURCE_DIR}/thirdparty/src. An overlay needs a writable thirdparty/src directory in the LibRPA checkout.\n${_error}")
      endif()
      # COPY preserves symlinks unless FOLLOW_SYMLINK_CHAIN is requested.
      file(COPY "${user_path}/" DESTINATION "${_tree}/${_HASH_SUBDIR}")
      # COPY retains read-only permissions. Make only the copy owner-writable,
      # preserving executable scripts and leaving the supplied tree unchanged.
      execute_process(COMMAND chmod -R u+w "${_tree}"
        RESULT_VARIABLE _chmod ERROR_VARIABLE _error)
      if(NOT _chmod EQUAL 0)
        file(REMOVE_RECURSE "${_temporary}")
        message(FATAL_ERROR "${name}: cannot make overlay owner-writable: ${_tree}\n${_error}")
      endif()
      librpa_thirdparty_tree_sha256(_copied "${_tree}/${_HASH_SUBDIR}")
      if(NOT _copied STREQUAL _hash)
        file(REMOVE_RECURSE "${_temporary}")
        message(FATAL_ERROR "${name}: copying the source tree changed its hash: ${user_path}")
      endif()
      _librpa_thirdparty_patch("${name}" "${_tree}" "${_temporary}")
      _librpa_thirdparty_publish("${name}" "${_tree}" "${_temporary}")
    endif()
    set(_resolved "${_final}")
    if(_HASH_SUBDIR)
      string(APPEND _resolved "/${_HASH_SUBDIR}")
    endif()
    _librpa_thirdparty_check_tree("${name}" "${_final}" _status)
    if(_status STREQUAL "managed")
      set(_status overlay)
    endif()
  else()
    message(WARNING "${name}: ${user_path} differs from the pinned version ${_VERSION}; compatibility will be determined when compiling (unpinned)")
    set(_status unpinned)
  endif()
  set(${out} "${_resolved}" PARENT_SCOPE)
  set(${status} "${_status}" PARENT_SCOPE)
endfunction()

function(librpa_thirdparty_target_include_dirs target out)
  get_target_property(_includes ${target} INTERFACE_INCLUDE_DIRECTORIES)
  if(NOT _includes)
    set(_includes "")
  endif()
  string(REGEX REPLACE "\\$<BUILD_INTERFACE:([^>]*)>" "\\1" _includes "${_includes}")
  string(REGEX REPLACE "\\$<INSTALL_INTERFACE:[^>]*>" "" _includes "${_includes}")
  if(_includes MATCHES "\\$<")
    message(FATAL_ERROR "${target}: unsupported include generator expression: ${_includes}")
  endif()
  list(REMOVE_ITEM _includes "")
  set(${out} "${_includes}" PARENT_SCOPE)
endfunction()

function(librpa_thirdparty_warn_installed name prefix managed_hint source_variable)
  message(WARNING "${name}: using a prebuilt installation (${prefix}). Prebuilt libraries may be incompatible with the compilers and flags used for LibRPA. Prefer the managed source (${managed_hint}), then a parent-project target, then ${source_variable}.")
endfunction()

# Resolve header-only dependencies without searching unrelated system paths.
function(librpa_thirdparty_resolve_headers name target variable marker out status)
  if(TARGET ${target})
    librpa_thirdparty_target_include_dirs(${target} _include)
    set(_status target)
  else()
    librpa_thirdparty_path(${variable} _user)
    if(NOT "${_user}" STREQUAL "")
      if(NOT EXISTS "${_user}/${marker}")
        message(FATAL_ERROR "${name}: invalid ${variable}=${_user}; missing ${marker}. No download fallback is allowed for an explicit path.")
      endif()
      librpa_thirdparty_use_path("${name}" "${_user}" _include _status)
    else()
      librpa_thirdparty_prepare("${name}" _source _status)
      set(_include "${_source}/include")
    endif()
    add_library(${target} INTERFACE IMPORTED GLOBAL)
    set_target_properties(${target} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_include}")
  endif()
  message(STATUS "${name}: ${_status}, includes=${_include}")
  set(${out} "${_include}" PARENT_SCOPE)
  set(${status} "${_status}" PARENT_SCOPE)
endfunction()
