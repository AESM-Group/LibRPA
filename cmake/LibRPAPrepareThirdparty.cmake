cmake_minimum_required(VERSION 3.13)
include("${CMAKE_CURRENT_LIST_DIR}/LibRPAThirdparty.cmake")
include("${LIBRPA_SOURCE_DIR}/thirdparty/manifest.cmake")
if(NOT COMPONENTS)
  get_property(COMPONENTS GLOBAL PROPERTY LIBRPA_THIRDPARTY_NAMES)
endif()
foreach(_component IN LISTS COMPONENTS)
  librpa_thirdparty_prepare_archive("${_component}" _archive)
  librpa_thirdparty_prepare("${_component}" _source)
endforeach()
