# Select a parent target, then source, installation, and managed source.
librpa_thirdparty_path(GREENX_SOURCE_DIR _greenx_user_source)
librpa_thirdparty_path(EXTERNAL_GREENX_DIR _greenx_prefix)
if(_greenx_user_source AND _greenx_prefix)
  message(FATAL_ERROR "greenX: GREENX_SOURCE_DIR and EXTERNAL_GREENX_DIR are mutually exclusive")
endif()

if(TARGET LibGXMiniMax)
  set(LIBRPA_GREENX_TARGET LibGXMiniMax)
  set(_greenx_status target)
elseif(TARGET greenX::LibGXMiniMax)
  set(LIBRPA_GREENX_TARGET greenX::LibGXMiniMax)
  set(_greenx_status target)
elseif(_greenx_user_source)
  if(NOT EXISTS "${_greenx_user_source}/GX-TimeFrequency/CMakeLists.txt")
    message(FATAL_ERROR "greenX: invalid GREENX_SOURCE_DIR=${_greenx_user_source}; missing GX-TimeFrequency/CMakeLists.txt. No download fallback is allowed for an explicit path.")
  endif()
  librpa_thirdparty_use_path(greenX "${_greenx_user_source}" _greenx_source_dir _greenx_status)
elseif(_greenx_prefix)
  # Ignore a cached greenX_DIR from a different installation.
  unset(greenX_DIR CACHE)
  unset(greenX_DIR)
  find_package(greenX CONFIG REQUIRED PATHS "${_greenx_prefix}" NO_DEFAULT_PATH)
  set(LIBRPA_GREENX_TARGET greenX::LibGXMiniMax)
  if(NOT TARGET ${LIBRPA_GREENX_TARGET})
    message(FATAL_ERROR "greenX: installation ${_greenx_prefix} does not provide greenX::LibGXMiniMax")
  endif()
  librpa_thirdparty_warn_installed(greenX "${_greenx_prefix}"
    "leave EXTERNAL_GREENX_DIR empty" GREENX_SOURCE_DIR)
  set(_greenx_status installed)

  # Installed modules come from MiniMax and its transitive GXCommon target.
  set(_greenx_pending ${LIBRPA_GREENX_TARGET})
  set(_greenx_seen "")
  set(_greenx_includes "")
  while(_greenx_pending)
    list(GET _greenx_pending 0 _target)
    list(REMOVE_AT _greenx_pending 0)
    if(_target IN_LIST _greenx_seen)
      continue()
    endif()
    list(APPEND _greenx_seen "${_target}")
    librpa_thirdparty_target_include_dirs(${_target} _includes)
    list(APPEND _greenx_includes ${_includes})
    get_target_property(_links ${_target} INTERFACE_LINK_LIBRARIES)
    foreach(_link IN LISTS _links)
      if(TARGET "${_link}")
        list(APPEND _greenx_pending "${_link}")
      endif()
    endforeach()
  endwhile()
  list(REMOVE_DUPLICATES _greenx_includes)
  foreach(_module gx_minimax kinds)
    set(_found FALSE)
    foreach(_include IN LISTS _greenx_includes)
      file(GLOB _modules "${_include}/*")
      foreach(_file IN LISTS _modules)
        get_filename_component(_filename "${_file}" NAME)
        string(TOLOWER "${_filename}" _filename)
        if(_filename STREQUAL "${_module}.mod" AND NOT IS_DIRECTORY "${_file}")
          set(_found TRUE)
        endif()
      endforeach()
    endforeach()
    if(NOT _found)
      message(FATAL_ERROR "greenX: installation ${_greenx_prefix} is missing ${_module}.mod in target include directories: ${_greenx_includes}")
    endif()
  endforeach()
  set(_greenx_compilers "")
  foreach(_include IN LISTS _greenx_includes)
    if(_include MATCHES "/greenX/([^/]+)-([0-9]+[.][0-9]+[^/]*)/")
      set(_compiler "${CMAKE_MATCH_1}")
      set(_version "${CMAKE_MATCH_2}")
      set(_signature "${_compiler}-${_version}")
      if(NOT _signature IN_LIST _greenx_compilers)
        list(APPEND _greenx_compilers "${_signature}")
        if(NOT _compiler STREQUAL CMAKE_Fortran_COMPILER_ID OR
            NOT _version VERSION_EQUAL CMAKE_Fortran_COMPILER_VERSION)
          message(WARNING "greenX: installed Fortran modules were built with ${_signature}; LibRPA uses ${CMAKE_Fortran_COMPILER_ID}-${CMAKE_Fortran_COMPILER_VERSION}")
        endif()
      endif()
    endif()
  endforeach()
elseif(LIBRPA_USE_EXTERNAL_GREENX)
  message(FATAL_ERROR "LIBRPA_USE_EXTERNAL_GREENX requires a parent-project LibGXMiniMax or greenX::LibGXMiniMax target, GREENX_SOURCE_DIR, or EXTERNAL_GREENX_DIR")
else()
  librpa_thirdparty_prepare(greenX _greenx_source_dir)
  set(_greenx_status managed)
endif()

if(_greenx_status MATCHES "^(managed|pinned|overlay|unpinned)$")
  add_subdirectory("${_greenx_source_dir}" "${CMAKE_CURRENT_BINARY_DIR}/thirdparty/greenx-build")
  set(LIBRPA_GREENX_TARGET LibGXMiniMax)
endif()
if(_greenx_status MATCHES "^(managed|pinned|overlay)$")
  get_property(_greenx_version GLOBAL PROPERTY LIBRPA_THIRDPARTY_greenX_VERSION)
  string(SUBSTRING "${_greenx_version}" 0 7 LIBRPA_GREENX_COMMIT_HASH)
elseif(_greenx_status STREQUAL "unpinned")
  set(LIBRPA_GREENX_COMMIT_HASH "(source: ${_greenx_user_source})")
elseif(_greenx_status STREQUAL "installed")
  set(LIBRPA_GREENX_COMMIT_HASH "(installed: ${_greenx_prefix})")
else()
  set(LIBRPA_GREENX_COMMIT_HASH "(EXTERNAL)")
endif()
string(APPEND LIBRPA_THIRDPARTY_SUMMARY "greenX=${_greenx_status}")
if(_greenx_status STREQUAL "installed")
  string(APPEND LIBRPA_THIRDPARTY_SUMMARY "(${_greenx_prefix})")
endif()
string(APPEND LIBRPA_THIRDPARTY_SUMMARY " ")
message(STATUS "greenX: ${_greenx_status}, target=${LIBRPA_GREENX_TARGET}, version=${LIBRPA_GREENX_COMMIT_HASH}")
