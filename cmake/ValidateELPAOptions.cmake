# Check explicit paths before dependency discovery or source preparation.
librpa_thirdparty_path(ELPA_SOURCE_DIR _elpa_user_source)
librpa_thirdparty_path(EXTERNAL_ELPA_DIR EXTERNAL_ELPA_DIR)
if(LIBRPA_USE_EXTERNAL_ELPA AND LIBRPA_USE_BUNDLED_ELPA)
  message(FATAL_ERROR "LIBRPA_USE_EXTERNAL_ELPA and LIBRPA_USE_BUNDLED_ELPA are mutually exclusive")
endif()
if(NOT "${_elpa_user_source}" STREQUAL "" AND NOT "${EXTERNAL_ELPA_DIR}" STREQUAL "")
  message(FATAL_ERROR "ELPA: ELPA_SOURCE_DIR and EXTERNAL_ELPA_DIR are mutually exclusive in every mode")
endif()
if(LIBRPA_USE_BUNDLED_ELPA AND NOT "${EXTERNAL_ELPA_DIR}" STREQUAL "")
  message(FATAL_ERROR "EXTERNAL_ELPA_DIR requires LIBRPA_USE_EXTERNAL_ELPA=ON and LIBRPA_USE_BUNDLED_ELPA=OFF")
endif()
if(LIBRPA_USE_EXTERNAL_ELPA AND NOT "${_elpa_user_source}" STREQUAL "")
  message(FATAL_ERROR "ELPA_SOURCE_DIR requires LIBRPA_USE_BUNDLED_ELPA=ON and LIBRPA_USE_EXTERNAL_ELPA=OFF")
endif()
if(NOT LIBRPA_USE_EXTERNAL_ELPA AND NOT LIBRPA_USE_BUNDLED_ELPA)
  if(NOT "${_elpa_user_source}" STREQUAL "")
    message(WARNING "ELPA_SOURCE_DIR is ignored unless LIBRPA_USE_BUNDLED_ELPA=ON")
  endif()
  if(NOT "${EXTERNAL_ELPA_DIR}" STREQUAL "")
    message(WARNING "EXTERNAL_ELPA_DIR is ignored unless LIBRPA_USE_EXTERNAL_ELPA=ON")
  endif()
endif()
