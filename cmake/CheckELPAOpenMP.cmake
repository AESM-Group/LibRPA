# Check known OpenMP dependencies before linking ELPA into LibRPA.
include_guard(GLOBAL)

function(librpa_check_openmp_libraries context)
  set(_gnu FALSE)
  set(_intel FALSE)
  foreach(_library IN LISTS ARGN)
    # Match library names, not toolchain directory names.
    if(_library MATCHES "(^|[/ ;\n]|-l)(lib)?(gomp|mkl_gnu_thread)([.; \n]|$)")
      set(_gnu TRUE)
    endif()
    if(_library MATCHES "(^|[/ ;\n]|-l)(lib)?(iomp5|omp|mkl_intel_thread)([.; \n]|$)")
      set(_intel TRUE)
    endif()
  endforeach()
  if(_gnu AND _intel)
    message(FATAL_ERROR
      "${context}: incompatible OpenMP runtimes (libgomp and libiomp5/libomp). "
      "Build ELPA and its math libraries with the same OpenMP runtime as LibRPA. "
      "Dependencies: ${ARGN}")
  endif()
endfunction()

function(librpa_check_elpa_source_openmp)
  # With ELPA OpenMP disabled, Fortran adds no OpenMP runtime of its own.
  set(_libraries ${OpenMP_CXX_LIBRARIES} ${MKL_LIBRARIES} ${LIBRPA_ELPA_LIBS})
  set(_openmp "${LIBRPA_ELPA_OPENMP}")
  separate_arguments(_extra_args UNIX_COMMAND "${LIBRPA_ELPA_CONFIGURE_ARGS}")
  foreach(_arg IN LISTS _extra_args)
    if(_arg MATCHES "^--enable-openmp(=yes)?$")
      set(_openmp ON)
    elseif(_arg MATCHES "^--(disable-openmp|enable-openmp=no)$")
      set(_openmp OFF)
    endif()
  endforeach()
  # The build wrapper adds OpenMP targets when LIBRPA_ELPA_OPENMP is ON,
  # even if an extra configure argument disables ELPA's OpenMP regions.
  if(LIBRPA_ELPA_OPENMP OR _openmp)
    find_package(OpenMP REQUIRED COMPONENTS C CXX Fortran)
    list(APPEND _libraries ${OpenMP_C_LIBRARIES} ${OpenMP_Fortran_LIBRARIES})
  endif()
  librpa_check_openmp_libraries("ELPA source build" ${_libraries})
endfunction()

function(librpa_check_elpa_openmp target)
  set(_queue ${target})
  set(_seen)
  set(_libraries ${OpenMP_CXX_LIBRARIES} ${MKL_LIBRARIES})
  set(_incomplete FALSE)
  while(_queue)
    list(POP_FRONT _queue _item)
    if(_item IN_LIST _seen)
      continue()
    endif()
    list(APPEND _seen "${_item}")
    if(TARGET "${_item}")
      get_target_property(_configs "${_item}" IMPORTED_CONFIGURATIONS)
      set(_properties IMPORTED_LOCATION INTERFACE_LINK_LIBRARIES)
      foreach(_config IN LISTS _configs)
        string(TOUPPER "${_config}" _config)
        list(APPEND _properties "IMPORTED_LOCATION_${_config}")
      endforeach()
      foreach(_property IN LISTS _properties)
        get_target_property(_value "${_item}" "${_property}")
        if(_value)
          list(APPEND _queue ${_value})
        endif()
      endforeach()
    elseif(_item MATCHES "\\$<")
      # Generator expressions cannot be evaluated during configuration.
      set(_incomplete TRUE)
    else()
      list(APPEND _libraries "${_item}")
      if(EXISTS "${_item}")
        if(_item MATCHES "\\.a$" OR CMAKE_CROSSCOMPILING)
          set(_incomplete TRUE)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
          # ldd includes transitive dependencies, including ELPA's BLAS layer.
          execute_process(COMMAND ldd "${_item}" RESULT_VARIABLE _result
            OUTPUT_VARIABLE _dependencies ERROR_VARIABLE _error)
          if(_result EQUAL 0)
            list(APPEND _libraries "${_dependencies}")
            if(_dependencies MATCHES "not found")
              set(_incomplete TRUE)
            endif()
          else()
            set(_incomplete TRUE)
          endif()
        else()
          set(_incomplete TRUE)
        endif()
      elseif(NOT _item MATCHES "^-l")
        set(_incomplete TRUE)
      endif()
    endif()
  endwhile()
  librpa_check_openmp_libraries("Prebuilt ELPA" ${_libraries})
  if(_incomplete)
    message(WARNING
      "ELPA OpenMP dependency check is incomplete (static library, generator "
      "expression, unavailable dependency, or unsupported inspection platform). "
      "Verify that ELPA and its math libraries use the same OpenMP runtime as "
      "LibRPA, or build ELPA from source with LIBRPA_USE_ELPA=ON and no ELPA_PATH.")
  endif()
endfunction()
